#include <stdio.h>

int main() {
       int num, i = 0, a[10];
    printf("enter  number : ");
  
    scanf("%d", & num);
    int n = num;
    while (n){
        a[i++] = n%10;
        n/=10;
    }
    for(int j = 0; j<i/2; j++){
        if(a[j] != a[i-j-1]){
            printf("It is a not a palindrome");
            return 0;
        }
    }
    
    printf("It is a palindrome");
    
    return 0;
}
  
